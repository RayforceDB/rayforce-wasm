{
  "name": "rayforce-wasm",
  "version": "0.2.1",
  "description": "RayforceDB WASM SDK - High-performance columnar database in WebAssembly",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/rayforce.sdk.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/rayforce.sdk.d.ts",
      "import": "./dist/rayforce.sdk.js"
    },
    "./wasm": {
      "import": "./dist/rayforce.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "make app",
    "build:dev": "make dev",
    "test": "node test.mjs && node test-contract.mjs",
    "prepublishOnly": "npm run build && npm test",
    "serve": "python3 -m http.server 8080"
  },
  "keywords": [
    "rayforce",
    "database",
    "wasm",
    "webassembly",
    "columnar",
    "analytics"
  ],
  "author": "RayforceDB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RayforceDB/rayforce-wasm.git"
  },
  "homepage": "https://rayforcedb.com",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "playwright": "^1.57.0"
  }
}
